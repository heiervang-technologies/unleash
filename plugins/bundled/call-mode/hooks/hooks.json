{
  "description": "Call mode: ring the owner before AskUserQuestion when call mode is on",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/call-mode-ask.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
